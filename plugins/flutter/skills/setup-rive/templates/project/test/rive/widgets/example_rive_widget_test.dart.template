// Runs without `rive_native`'s platform library: the widget's Rive layer is
// replaced through `riveBuilder`, because loading that library fails under
// `flutter test` where it is not provisioned. This test covers the widget's
// own logic (tap -> toggle the bound property). That the real fixture
// `assets/rive/ui/example.riv` exposes a boolean View Model property named
// `isActive` is verified by running the app, not here.
// See `docs/rive-profile.md` and `rules/rive.md`.
import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:[package-name]/ui/rive/widgets/example_rive_widget.dart';

class _FakeBooleanProperty implements BooleanProperty {
  @override
  bool value = false;
}

void main() {
  testWidgets('flips the bound boolean property on tap', (tester) async {
    final property = _FakeBooleanProperty();

    await tester.pumpWidget(
      MaterialApp(
        home: Scaffold(
          body: ExampleRiveWidget(
            riveBuilder: (context, onBound) {
              onBound(property);
              return const SizedBox.expand(
                child: ColoredBox(color: Colors.blue),
              );
            },
          ),
        ),
      ),
    );

    final state = tester.state<ExampleRiveWidgetState>(
      find.byType(ExampleRiveWidget),
    );
    expect(state.isActive, same(property));

    await tester.tap(find.byType(ExampleRiveWidget));
    await tester.pump();
    expect(property.value, isTrue);

    await tester.tap(find.byType(ExampleRiveWidget));
    await tester.pump();
    expect(property.value, isFalse);
  });
}
