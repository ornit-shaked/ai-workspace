import 'package:flutter/material.dart';
import 'package:rive/rive.dart';

/// A minimal example of this project's Rive integration pattern: load a `.riv`
/// through a [FileLoader], render it with [RiveWidgetBuilder], and drive its
/// state machine by setting a boolean View Model property via Data Binding.
///
/// Note Data Binding is used deliberately — the older
/// `stateMachine.boolean(name)` state-machine-input API is deprecated in the
/// Rive runtime in favour of View Model properties.
///
/// Delete this widget, its test, and the fixture `.riv` once real animation
/// content exists (see `docs/flame-rive-integration.md`).
class ExampleRiveWidget extends StatefulWidget {
  /// Creates an [ExampleRiveWidget].
  const ExampleRiveWidget({super.key});

  /// Asset path of the fixture this example drives.
  static const String assetPath = 'assets/rive/ui/example.riv';

  /// Name of the fixture's boolean View Model property this example toggles.
  ///
  /// The fixture must expose a boolean property under this name, on a View
  /// Model instance marked as exported in the Rive Editor (so [DataBind.auto]
  /// can resolve it).
  static const String booleanPropertyName = 'isActive';

  @override
  ExampleRiveWidgetState createState() => ExampleRiveWidgetState();
}

/// State for [ExampleRiveWidget].
///
/// Public so a host holding a `GlobalKey<ExampleRiveWidgetState>` (or a test)
/// can read the bound property via [isActive].
class ExampleRiveWidgetState extends State<ExampleRiveWidget> {
  late final FileLoader _fileLoader;

  ViewModelInstanceBoolean? _isActive;

  /// The fixture's bound boolean property, available once the file has loaded
  /// (`null` while loading, or if the fixture does not expose
  /// [ExampleRiveWidget.booleanPropertyName]).
  ViewModelInstanceBoolean? get isActive => _isActive;

  @override
  void initState() {
    super.initState();
    _fileLoader = FileLoader.fromAsset(
      ExampleRiveWidget.assetPath,
      riveFactory: Factory.flutter,
    );
  }

  @override
  void dispose() {
    // RiveWidgetBuilder disposes the controller and the view model instance;
    // the FileLoader is owned here, so it is disposed here.
    _fileLoader.dispose();
    super.dispose();
  }

  void _toggle() {
    final isActive = _isActive;
    if (isActive == null) return;
    isActive.value = !isActive.value;
  }

  @override
  Widget build(BuildContext context) {
    return RiveWidgetBuilder(
      fileLoader: _fileLoader,
      dataBind: DataBind.auto(),
      onLoaded: (state) => _isActive = state.viewModelInstance?.boolean(
        ExampleRiveWidget.booleanPropertyName,
      ),
      builder: (context, state) => switch (state) {
        RiveLoading() => const Center(child: CircularProgressIndicator()),
        RiveFailed() => Center(
            child: Text('Failed to load Rive file: ${state.error}'),
          ),
        RiveLoaded() => GestureDetector(
            onTap: _toggle,
            child: RiveWidget(controller: state.controller),
          ),
      },
    );
  }
}
