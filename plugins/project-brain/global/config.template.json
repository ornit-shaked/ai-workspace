{
  "permissions": {
    "allow": [
      "Exec(git commit)",
      "Exec(git push)",
      "Exec(git pull)",
      "Exec(git checkout)",
      "Exec(git branch)",
      "Exec(git log)",
      "Exec(git diff)",
      "Exec(git status)",
      "Exec(git add)",
      "Exec(npm test)",
      "Exec(npm run)",
      "Exec(npx)",
      "Read(**)",
      "Write(src/**)",
      "Write(tests/**)",
      "Write(.devin/**)",
      "Write(.project-brain/**)"
    ],
    "deny": [
      "Exec(rm -rf)",
      "Exec(sudo)"
    ]
  }
}
